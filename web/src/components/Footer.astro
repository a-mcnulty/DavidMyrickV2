            </svg>
          )}
        </a>
      ))}
    </div>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--c-negative);
    padding: var(--space-6) 0;
    margin-top: var(--space-9);
  }

  .footer-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-4);
  }

  @media (min-width: 640px) {
    .footer-inner {
      flex-direction: row;
      justify-content: space-between;
    }
  }

  .copyright {
    font-family: var(--font-utility);
    font-size: var(--text-utility);
    font-weight: var(--weight-medium);
    color: var(--c-slate);
    letter-spacing: var(--tracking-normal);
    text-transform: uppercase;
  }

  .social {
    display: flex;
    gap: var(--space-4);
  }

  .social-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: var(--tap-min);
    height: var(--tap-min);
    color: var(--c-slate);
    transition: color var(--duration-sm) var(--ease-out);
  }

  .social-link:hover {
    color: var(--c-daylight);
  }
</style>
