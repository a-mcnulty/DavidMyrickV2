---
import { urlFor, extractVimeoId } from '../lib/sanity';
import type { SanityImageSource } from '@sanity/image-url/lib/types/types';
import type { VimeoDimensions } from '../lib/sanity';

interface Props {
  id: string;
  title: string;
  coverImage?: SanityImageSource;
  vimeoThumbnail?: string;
  subcategory?: string;
  director?: string;
  tileVideoUrl?: string;
  tileVideoDimensions?: VimeoDimensions;
  index?: number;
}

const {
  id,
  title,
  coverImage,
  vimeoThumbnail,
  subcategory,
  director,
  tileVideoUrl,
  tileVideoDimensions,
  index = 1,
} = Astro.props;

const isFirst = index === 0;
const tileVimeoId = tileVideoUrl ? extractVimeoId(tileVideoUrl) : null;

const hasSanityImage = !!coverImage;
const srcSet = hasSanityImage
  ? [480, 800, 1200, 1800]
      .map((w) => `${urlFor(coverImage).width(w).format('webp').url()} ${w}w`)
      .join(', ')
  : undefined;
const fallbackSrc = hasSanityImage
  ? urlFor(coverImage).width(1200).auto('format').url()
  : vimeoThumbnail ?? undefined;
---

<article
  class:list={['tile', { 'is-first': isFirst }]}
  data-lightbox-trigger={id}
  data-tile-vimeo={tileVimeoId ?? undefined}
  role="button"
  tabindex="0"
  aria-label={`View ${title}`}
  style={tileVideoDimensions ? `--tile-vw: ${tileVideoDimensions.width}; --tile-vh: ${tileVideoDimensions.height}` : undefined}
>
  {/* Poster image (visible until video loads) */}
  <div class="tile-frame">
    {fallbackSrc && (
      <img
        class="tile-poster"
        src={fallbackSrc}
        srcset={srcSet}
        sizes={srcSet ? '100vw' : undefined}
        alt={title}
        loading={isFirst ? 'eager' : 'lazy'}
        decoding="async"
        fetchpriority={isFirst ? 'high' : undefined}
        width="1200"
        height="675"
      />
    )}
  </div>

  {/* Text overlay */}
  <div class="tile-overlay">
    {subcategory && (
      <span class="tile-subcategory">{subcategory}</span>
    )}
    <h2 class="tile-title">{title}</h2>
    {director && (
      <span class="tile-director">{director}</span>
    )}
  </div>
</article>

<style>
  .tile {
    position: relative;
    overflow: hidden;
    cursor: pointer;
    outline: none;
  }

  .tile:focus-visible {
    outline: 2px solid var(--c-tungsten);
    outline-offset: 2px;
  }

  /* --- Frame: responsive aspect ratio --- */

  .tile-frame {
    position: relative;
    aspect-ratio: var(--ratio-viewfinder);
    overflow: hidden;
    background: var(--c-negative);
  }

  @media (min-width: 640px) {
    .tile-frame {
      aspect-ratio: var(--ratio-wide);
    }
  }

  @media (min-width: 1024px) {
    .tile-frame {
      aspect-ratio: var(--ratio-cinematic);
    }
  }

  .tile-poster {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transition: opacity var(--duration-lg) var(--ease-out);
  }

  /* Hide poster once video iframe is injected */
  .tile.has-video .tile-poster {
    opacity: 0;
  }

  /* Vimeo SDK container + iframe — covers the crop frame, centered */
  .tile :global(.tile-video) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  .tile :global(.tile-video iframe) {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    min-width: 100%;
    min-height: 100%;
    width: auto;
    height: auto;
    aspect-ratio: var(--tile-vw, 16) / var(--tile-vh, 9);
    border: 0;
    pointer-events: none;
  }

  /* --- Text overlay --- */

  .tile-overlay {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: var(--space-5);
    pointer-events: none;
    transition: opacity var(--duration-md) var(--ease-out);
  }

  .tile:hover .tile-overlay {
    opacity: 0.6;
  }

  :global([data-theme="light"]) .tile:hover .tile-overlay {
    opacity: 1;
  }

  .tile-subcategory {
    font-family: var(--font-utility);
    font-weight: var(--weight-medium);
    font-size: var(--text-utility);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    color: #e8e4df;
    opacity: 0.8;
    margin-bottom: var(--space-2);
    text-shadow: 0 1px 4px rgba(0, 0, 0, 0.6);
  }

  .tile-title {
    font-family: var(--font-display);
    font-size: calc(var(--text-tile) * 1.1);
    text-transform: uppercase;
    letter-spacing: var(--tracking-display);
    line-height: 1.05;
    color: #e8e4df;
    text-shadow: 0 2px 8px rgba(0, 0, 0, 0.7);
    backdrop-filter: blur(2px);
    -webkit-backdrop-filter: blur(2px);
    padding: var(--space-2) var(--space-4);
    border-radius: 2px;
  }

  .tile-director {
    font-family: var(--font-body);
    font-weight: var(--weight-regular);
    font-size: calc(var(--text-small) * 1.15);
    color: #e8e4df;
    opacity: 0.7;
    margin-top: var(--space-2);
    letter-spacing: var(--tracking-normal);
    text-shadow: 0 1px 4px rgba(0, 0, 0, 0.6);
  }
</style>
