---
// Handles: tile background video (Vimeo SDK), lightbox open/close, full video lifecycle.
// Include once per page.
---

<script>
  declare function gtag(...args: any[]): void;

  async function init() {
    const { default: Player } = await import('@vimeo/player');
    // === Tile background videos: load first tile immediately, rest on scroll ===

    function loadTileVideo(tile: HTMLElement) {
      if (tile.classList.contains('has-video')) return;
      const vimeoId = tile.dataset.tileVimeo;
      if (!vimeoId) return;

      const frame = tile.querySelector('.tile-frame');
      if (!frame) return;

      const container = document.createElement('div');
      container.className = 'tile-video';
      frame.appendChild(container);

      const player = new Player(container, {
        id: parseInt(vimeoId, 10),
        background: true,
        muted: true,
        autoplay: true,
        loop: true,
        dnt: true,
        responsive: false,
      });

      player.on('play', () => {
        tile.classList.add('has-video');
      });
    }

    const tiles = document.querySelectorAll<HTMLElement>('[data-tile-vimeo]');

    const tileObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            loadTileVideo(entry.target as HTMLElement);
            tileObserver.unobserve(entry.target);
          }
        });
      },
      { rootMargin: '0px' }
    );

    function observeRemainingTiles() {
      tiles.forEach((tile, i) => {
        if (i === 0) return;
        tileObserver.observe(tile);
      });
    }

    function startTileVideos() {
      if (tiles.length === 0) return;

      const firstTile = tiles[0];
      loadTileVideo(firstTile);

      const firstPlayer = firstTile.querySelector('.tile-video');
      if (firstPlayer) {
        const checkPlay = () => {
          if (firstTile.classList.contains('has-video')) {
            observeRemainingTiles();
          } else {
            requestAnimationFrame(checkPlay);
          }
        };
        requestAnimationFrame(checkPlay);
      }

      setTimeout(observeRemainingTiles, 8000);
    }

    if ('requestIdleCallback' in window) {
      requestIdleCallback(() => startTileVideos());
    } else {
      setTimeout(startTileVideos, 200);
    }

    // === Lightbox open/close ===
    const triggers = document.querySelectorAll<HTMLElement>('[data-lightbox-trigger]');
    const lightboxes = document.querySelectorAll<HTMLElement>('[data-lightbox-id]');
    const playerMap = new Map<HTMLElement, Player>();
    const controlsMap = new Map<HTMLElement, AbortController>();

    function setupControls(lb: HTMLElement, wrapper: HTMLElement, player: any) {
      const controls = wrapper.querySelector<HTMLElement>('.vp-controls');
      const overlay = wrapper.querySelector<HTMLElement>('.vp-overlay');
      if (!controls || !overlay) return;

      const ac = new AbortController();
      const sig = ac.signal;
      controlsMap.set(wrapper, ac);

      const playBtn = controls.querySelector<HTMLElement>('.vp-play')!;
      const timeline = controls.querySelector<HTMLElement>('.vp-timeline')!;
      const progress = controls.querySelector<HTMLElement>('.vp-progress')!;
      const muteBtn = controls.querySelector<HTMLElement>('.vp-mute')!;
      const volSlider = controls.querySelector<HTMLInputElement>('.vp-vol')!;
      const fsBtn = controls.querySelector<HTMLElement>('.vp-fs')!;

      let duration = 0;
      let isPaused = false;
      let hideTimer: number;

      player.getDuration().then((d: number) => { duration = d; });

      player.getPaused().then((p: boolean) => {
        playBtn.classList.toggle('is-paused', p);
      });

      function showControls() {
        controls.classList.add('visible');
        clearTimeout(hideTimer);
        if (!isPaused) {
          hideTimer = window.setTimeout(() => controls.classList.remove('visible'), 3000);
        }
      }

      function togglePlay() {
        player.getPaused().then((p: boolean) => {
          if (p) player.play();
          else player.pause();
        });
      }

      player.on('play', () => {
        isPaused = false;
        playBtn.classList.remove('is-paused');
        showControls();
      });

      player.on('pause', () => {
        isPaused = true;
        playBtn.classList.add('is-paused');
        showControls();
      });

      playBtn.addEventListener('click', togglePlay, { signal: sig });
      overlay.addEventListener('click', () => { togglePlay(); showControls(); }, { signal: sig });

      player.on('timeupdate', (data: { seconds: number }) => {
        if (duration) progress.style.width = `${(data.seconds / duration) * 100}%`;
      });

      function seek(clientX: number) {
        if (!duration) return;
        const rect = timeline.getBoundingClientRect();
        const pct = Math.max(0, Math.min(1, (clientX - rect.left) / rect.width));
        player.setCurrentTime(pct * duration);
        progress.style.width = `${pct * 100}%`;
      }

      let seeking = false;
      timeline.addEventListener('pointerdown', (e: PointerEvent) => {
        seeking = true;
        timeline.setPointerCapture(e.pointerId);
        seek(e.clientX);
      }, { signal: sig });
      timeline.addEventListener('pointermove', (e: PointerEvent) => {
        if (seeking) seek(e.clientX);
      }, { signal: sig });
      timeline.addEventListener('pointerup', () => { seeking = false; }, { signal: sig });

      muteBtn.addEventListener('click', () => {
        player.getVolume().then((v: number) => {
          player.setVolume(v > 0 ? 0 : 1);
        });
      }, { signal: sig });

      player.on('volumechange', (data: { volume: number }) => {
        muteBtn.classList.toggle('is-muted', data.volume === 0);
        volSlider.value = String(data.volume);
      });

      volSlider.addEventListener('input', () => {
        player.setVolume(parseFloat(volSlider.value));
      }, { signal: sig });

      fsBtn.addEventListener('click', () => {
        if (document.fullscreenElement) {
          document.exitFullscreen();
        } else {
          wrapper.requestFullscreen();
        }
      }, { signal: sig });

      overlay.addEventListener('mousemove', showControls, { signal: sig });
      overlay.addEventListener('touchstart', showControls, { signal: sig, passive: true });
      controls.addEventListener('mousemove', showControls, { signal: sig });
      controls.addEventListener('mouseenter', showControls, { signal: sig });

      showControls();
    }

    function openLightbox(id: string) {
      const lb = document.querySelector<HTMLElement>(`[data-lightbox-id="${id}"]`);
      if (!lb) return;

      if (typeof gtag === 'function') {
        const videoTitle = lb.getAttribute('aria-label') || 'Unknown';
        const category = window.location.pathname.replace(/\//g, '') || 'home';
        gtag('event', 'project_view', {
          project_title: videoTitle,
          page_category: category,
        });
      }

      const wrapper = lb.querySelector<HTMLElement>('[data-full-vimeo-id]');
      if (wrapper && !playerMap.has(wrapper)) {
        const vimeoId = wrapper.dataset.fullVimeoId;
        if (vimeoId) {
          const container = document.createElement('div');
          container.className = 'lightbox-video';
          wrapper.appendChild(container);

          const player = new Player(container, {
            id: parseInt(vimeoId, 10),
            autoplay: true,
            controls: false,
            title: false,
            byline: false,
            portrait: false,
            dnt: true,
            responsive: false,
          });
          playerMap.set(wrapper, player);

          const videoTitle = lb.getAttribute('aria-label') || 'Unknown';
          const milestones = new Set<number>();

          player.getDuration().then((duration: number) => {
            player.on('play', () => {
              if (typeof gtag === 'function') {
                gtag('event', 'video_start', {
                  video_title: videoTitle,
                  video_provider: 'vimeo',
                  video_url: `https://vimeo.com/${vimeoId}`,
                });
              }
            });

            player.on('pause', () => {
              if (typeof gtag === 'function') {
                gtag('event', 'video_pause', {
                  video_title: videoTitle,
                  video_provider: 'vimeo',
                });
              }
            });

            player.on('ended', () => {
              if (typeof gtag === 'function') {
                gtag('event', 'video_complete', {
                  video_title: videoTitle,
                  video_provider: 'vimeo',
                });
              }
            });

            player.on('timeupdate', (data: { seconds: number }) => {
              if (!duration) return;
              const pct = Math.floor((data.seconds / duration) * 100);
              for (const mark of [25, 50, 75]) {
                if (pct >= mark && !milestones.has(mark)) {
                  milestones.add(mark);
                  if (typeof gtag === 'function') {
                    gtag('event', 'video_progress', {
                      video_title: videoTitle,
                      video_provider: 'vimeo',
                      video_percent: mark,
                    });
                  }
                }
              }
            });
          });

          setupControls(lb, wrapper, player);
        }
      } else if (wrapper && playerMap.has(wrapper)) {
        playerMap.get(wrapper)!.play();
      }

      lb.classList.add('open');
      document.body.style.overflow = 'hidden';
      lb.querySelector<HTMLButtonElement>('.lightbox-close')?.focus();
    }

    function closeLightbox(lb: HTMLElement) {
      lb.classList.remove('open');
      document.body.style.overflow = '';

      const wrapper = lb.querySelector<HTMLElement>('[data-full-vimeo-id]');
      if (wrapper) {
        if (controlsMap.has(wrapper)) {
          controlsMap.get(wrapper)!.abort();
          controlsMap.delete(wrapper);
        }
        const controls = wrapper.querySelector<HTMLElement>('.vp-controls');
        const progress = wrapper.querySelector<HTMLElement>('.vp-progress');
        if (controls) controls.classList.remove('visible');
        if (progress) progress.style.width = '0%';

        if (playerMap.has(wrapper)) {
          playerMap.get(wrapper)!.destroy();
          playerMap.delete(wrapper);
        }
      }
    }

    triggers.forEach((trigger) => {
      const id = trigger.dataset.lightboxTrigger!;
      trigger.addEventListener('click', () => openLightbox(id));
      trigger.addEventListener('keydown', (e: KeyboardEvent) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          openLightbox(id);
        }
      });
    });

    lightboxes.forEach((lb) => {
      lb.querySelectorAll('[data-lightbox-close]').forEach((el) => {
        el.addEventListener('click', () => closeLightbox(lb));
      });
    });

    document.addEventListener('keydown', (e: KeyboardEvent) => {
      if (e.key === 'Escape') {
        lightboxes.forEach((lb) => {
          if (lb.classList.contains('open')) closeLightbox(lb);
        });
      }
    });
  }

  document.addEventListener('astro:page-load', init);
</script>
