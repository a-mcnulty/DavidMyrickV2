---
const navItems = [
  { num: '01', label: 'Music Video', href: '/music-video' },
  { num: '02', label: 'Commercial', href: '/commercial' },
  { num: '03', label: 'Narrative', href: '/narrative' },
  { num: '04', label: "Let's Talk", href: '/lets-talk' },
];

const currentPath = Astro.url.pathname;

function isActive(href: string): boolean {
  return currentPath === href || currentPath.startsWith(href + '/');
}
---

<header class="header">
  <div class="header-bar">
    <a href="/" class:list={['logo', { active: currentPath === '/' }]}><span class="logo-dot" aria-hidden="true"></span>David J Myrick</a>

    <button class="theme-toggle" aria-label="Toggle light/dark mode">
      <svg class="icon-sun" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
        <circle cx="12" cy="12" r="5" />
        <line x1="12" y1="1" x2="12" y2="3" /><line x1="12" y1="21" x2="12" y2="23" />
        <line x1="4.22" y1="4.22" x2="5.64" y2="5.64" /><line x1="18.36" y1="18.36" x2="19.78" y2="19.78" />
        <line x1="1" y1="12" x2="3" y2="12" /><line x1="21" y1="12" x2="23" y2="12" />
        <line x1="4.22" y1="19.78" x2="5.64" y2="18.36" /><line x1="18.36" y1="5.64" x2="19.78" y2="4.22" />
      </svg>
      <svg class="icon-moon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
        <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
      </svg>
    </button>

    <button
      class="menu-toggle"
      aria-label="Toggle menu"
      aria-expanded="false"
    >
      <span class="bar"></span>
      <span class="bar"></span>
      <span class="bar"></span>
    </button>

    <!-- Tablet-only: plain text links -->
    <nav class="nav-tablet" aria-label="Main navigation">
      {navItems.map(({ label, href }) => (
        <a
          href={href}
          class:list={['nav-tablet-link', { active: isActive(href) }]}
        >
          <span class="tablet-label">{label}</span>
          <span class="tablet-dot" aria-hidden="true"></span>
        </a>
      ))}
    </nav>
  </div>

  <!-- Desktop: numbered editorial grid -->
  <nav class="nav-desktop" aria-label="Main navigation">
    <ul class="nav-grid">
      {navItems.map(({ num, label, href }) => (
        <li>
          <a
            href={href}
            class:list={['nav-cell', { active: isActive(href) }]}
          >
            <span class="nav-num">{num}</span>
            <span class="nav-label">{label}</span>
            <span class="nav-dot" aria-hidden="true"></span>
          </a>
        </li>
      ))}
    </ul>
  </nav>

  <!-- Mobile: full-screen overlay -->
  <nav class="nav-overlay" aria-label="Main navigation">
    <button class="overlay-close" data-overlay-close aria-label="Close menu">
      <svg width="24" height="24" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
        <line x1="5" y1="5" x2="19" y2="19" />
        <line x1="19" y1="5" x2="5" y2="19" />
      </svg>
    </button>
    <ul class="overlay-list">
      {navItems.map(({ num, label, href }) => (
        <li>
          <a
            href={href}
            class:list={['overlay-link', { active: isActive(href) }]}
          >
            <span class="overlay-num">{num}</span>
            <span class="overlay-label-row">
              <span class="overlay-dot" aria-hidden="true"></span>
              <span class="overlay-label">{label}</span>
            </span>
          </a>
        </li>
      ))}
    </ul>
  </nav>
</header>

<script>
  const themeBtn = document.querySelector('.theme-toggle');
  function applyTheme(theme: string) {
    document.documentElement.setAttribute('data-theme', theme);
    localStorage.setItem('theme', theme);
  }
  const saved = localStorage.getItem('theme') || 'light';
  applyTheme(saved);
  themeBtn?.addEventListener('click', () => {
    const current = document.documentElement.getAttribute('data-theme') || 'dark';
    applyTheme(current === 'dark' ? 'light' : 'dark');
  });

  const toggle = document.querySelector('.menu-toggle');
  const overlay = document.querySelector('.nav-overlay');

  toggle?.addEventListener('click', () => {
    const expanded = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!expanded));
    overlay?.classList.toggle('open');
    document.body.style.overflow = expanded ? '' : 'hidden';
  });

  overlay?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      toggle?.setAttribute('aria-expanded', 'false');
      overlay?.classList.remove('open');
      document.body.style.overflow = '';
    });
  });

  document.querySelector('.overlay-close')?.addEventListener('click', () => {
    toggle?.setAttribute('aria-expanded', 'false');
    overlay?.classList.remove('open');
    document.body.style.overflow = '';
  });
</script>

<style>
  /* ===== Header bar (logo + hamburger / tablet links) ===== */

  .header-bar {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 200;
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: var(--nav-height);
    padding: 0 var(--space-4);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
  }

  @media (min-width: 640px) {
    .header-bar {
      padding: 0 var(--space-5);
    }
  }

  .theme-toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    color: var(--c-daylight);
    transition: color var(--duration-sm) var(--ease-out);
    margin-left: auto;
    margin-right: var(--space-3);
    flex-shrink: 0;
  }

  /* Dark mode: show sun (click to go light), hide moon */
  .icon-moon { display: none; }
  .icon-sun { display: block; }

  :global([data-theme="light"]) .icon-sun { display: none; }
  :global([data-theme="light"]) .icon-moon { display: block; }

  .logo {
    font-family: var(--font-display);
    font-size: clamp(1.1rem, 2.5vw, 1.4rem);
    text-transform: uppercase;
    letter-spacing: var(--tracking-display);
    line-height: 1;
    color: var(--c-daylight);
    white-space: nowrap;
    display: flex;
    align-items: center;
    gap: var(--space-2);
      }

  .logo-dot {
    width: 8px;
    height: 8px;
    background: var(--c-slate);
    flex-shrink: 0;
    transition: background var(--duration-sm) var(--ease-out);
  }

  .logo:hover .logo-dot,
  .logo.active .logo-dot {
    background: var(--c-tally);
  }

  /* ===== Hamburger toggle ===== */

  .menu-toggle {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: var(--space-2);
    width: var(--tap-min);
    height: var(--tap-min);
    padding: var(--space-3);
    z-index: 210;
  }

  .bar {
    display: block;
    width: 100%;
    height: 2px;
    background: var(--c-daylight);
    transition: transform var(--duration-md) var(--ease-out),
                opacity var(--duration-md) var(--ease-out);
    transform-origin: center;
  }

  /* Animate to X when open */
  .menu-toggle[aria-expanded='true'] .bar:nth-child(1) {
    transform: translateY(8px) rotate(45deg);
  }
  .menu-toggle[aria-expanded='true'] .bar:nth-child(2) {
    opacity: 0;
  }
  .menu-toggle[aria-expanded='true'] .bar:nth-child(3) {
    transform: translateY(-8px) rotate(-45deg);
  }

  /* Hide hamburger on tablet+ (tablet shows inline links, desktop shows grid) */
  @media (min-width: 640px) {
    .menu-toggle {
      display: none;
    }
  }

  /* ===== Tablet nav: plain horizontal links ===== */

  .nav-tablet {
    display: none;
  }

  @media (min-width: 640px) {
    .nav-tablet {
      display: flex;
      align-items: stretch;
      gap: 0;
      border-top: 1px solid var(--c-daylight);
      border-bottom: 1px solid var(--c-daylight);
    }
  }

  .nav-tablet-link {
    font-family: var(--font-utility);
    font-weight: var(--weight-medium);
    font-size: var(--text-utility);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    color: var(--c-daylight);
    padding: var(--space-3) var(--space-4);
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    white-space: nowrap;
    border-left: 1px solid var(--c-daylight);
    border-right: 1px solid var(--c-daylight);
    margin-left: -1px;
    transition: color var(--duration-sm) var(--ease-out),
                background var(--duration-sm) var(--ease-out);
  }

  .nav-tablet-link:first-child {
    margin-left: 0;
  }

  .nav-tablet-link:hover {
    color: var(--c-daylight);
    background: var(--c-negative);
  }

  .nav-tablet-link.active {
    color: var(--c-daylight);
  }

  .tablet-label {
    font-weight: var(--weight-semibold);
    font-size: var(--text-utility);
        transition: color var(--duration-sm) var(--ease-out);
  }

  .tablet-dot {
    width: 6px;
    height: 6px;
    background: var(--c-slate);
    flex-shrink: 0;
    margin-top: var(--space-1);
    transition: background var(--duration-sm) var(--ease-out);
  }

  .nav-tablet-link:hover .tablet-dot {
    background: var(--c-tally);
  }

  .nav-tablet-link.active .tablet-dot {
    background: var(--c-tally);
  }

  /* ===== Desktop nav: numbered editorial grid ===== */

  .nav-desktop {
    display: none;
  }

  .nav-desktop {
    display: none;
  }

  .nav-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    list-style: none;
  }

  .nav-cell {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-4) var(--space-5);
    border-left: 1px solid var(--c-daylight);
    transition: background var(--duration-sm) var(--ease-out);
  }

  .nav-cell:hover {
    background: var(--c-negative);
  }

  .nav-grid li:first-child .nav-cell {
    border-left: none;
  }

  .nav-num {
    font-family: var(--font-utility);
    font-weight: var(--weight-medium);
    font-size: var(--text-utility);
    letter-spacing: var(--tracking-wide);
    color: var(--c-slate);
    transition: color var(--duration-sm) var(--ease-out);
  }

  .nav-label {
    font-family: var(--font-utility);
    font-weight: var(--weight-semibold);
    font-size: var(--text-small);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    color: var(--c-slate);
    transition: color var(--duration-sm) var(--ease-out);
  }

  .nav-dot {
    width: 8px;
    height: 8px;
    background: var(--c-slate);
    margin-top: var(--space-1);
    transition: background var(--duration-sm) var(--ease-out);
  }

  .nav-cell:hover .nav-num,
  .nav-cell:hover .nav-label {
    color: var(--c-daylight);
  }

  .nav-cell:hover .nav-dot {
    background: var(--c-tally);
  }

  .nav-cell.active .nav-num,
  .nav-cell.active .nav-label {
    color: var(--c-daylight);
  }

  .nav-cell.active .nav-dot {
    background: var(--c-tally);
  }

  /* ===== Mobile overlay: full-screen chapter select ===== */

  .nav-overlay {
    position: fixed;
    inset: 0;
    z-index: 200;
    background: var(--c-darkroom);
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    visibility: hidden;
    transition: opacity var(--duration-md) var(--ease-out),
                visibility var(--duration-md) var(--ease-out);
  }

  .nav-overlay.open {
    opacity: 1;
    visibility: visible;
  }

  /* Only used on mobile */
  @media (min-width: 640px) {
    .nav-overlay {
      display: none !important;
    }
  }

  .overlay-close {
    position: absolute;
    top: var(--space-4);
    right: var(--space-4);
    display: flex;
    align-items: center;
    justify-content: center;
    width: var(--tap-min);
    height: var(--tap-min);
    color: var(--c-slate);
    transition: color var(--duration-sm) var(--ease-out);
  }

  .overlay-close:hover {
    color: var(--c-daylight);
  }

  .overlay-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    width: 100%;
    max-width: 320px;
    border-top: 1px solid var(--c-daylight);
  }

  .overlay-list li {
    border-bottom: 1px solid var(--c-daylight);
    border-left: 1px solid var(--c-daylight);
    border-right: 1px solid var(--c-daylight);
  }

  .overlay-link {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-5) var(--space-5);
    transition: background var(--duration-sm) var(--ease-out);
  }

  .overlay-link:hover {
    background: var(--c-negative);
  }

  .overlay-num {
    font-family: var(--font-utility);
    font-weight: var(--weight-medium);
    font-size: var(--text-utility);
    letter-spacing: var(--tracking-wide);
    color: var(--c-slate);
  }

  .overlay-label-row {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .overlay-dot {
    width: 8px;
    height: 8px;
    background: var(--c-slate);
    flex-shrink: 0;
    transition: background var(--duration-sm) var(--ease-out);
  }

  .overlay-label {
    font-family: var(--font-display);
    font-size: clamp(1.4rem, 5vw, 2rem);
    text-transform: uppercase;
    letter-spacing: var(--tracking-display);
    line-height: 1;
    color: var(--c-daylight);
  }

  .overlay-link:hover .overlay-dot {
    background: var(--c-tally);
  }

  .overlay-link.active .overlay-num {
    color: var(--c-daylight);
  }

  .overlay-link.active .overlay-label {
    color: var(--c-daylight);
  }

  .overlay-link.active .overlay-dot {
    background: var(--c-tally);
  }
</style>
