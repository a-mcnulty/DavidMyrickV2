---
const navItems = [
  { num: '01', label: 'Photography', href: '/photography' },
  { num: '02', label: 'Music Video', href: '/music-video' },
  { num: '03', label: 'Commercial', href: '/commercial' },
  { num: '04', label: 'Narrative', href: '/narrative' },
  { num: '05', label: "Let's Talk", href: '/lets-talk' },
];

const currentPath = Astro.url.pathname;

function isActive(href: string): boolean {
  return currentPath === href || currentPath.startsWith(href + '/');
}
---

<header class="header">
  <div class="header-bar">
    <a href="/" class="logo">David J Myrick</a>

    <button
      class="menu-toggle"
      aria-label="Toggle menu"
      aria-expanded="false"
    >
      <span class="bar"></span>
      <span class="bar"></span>
      <span class="bar"></span>
    </button>

    <!-- Tablet-only: plain text links -->
    <nav class="nav-tablet" aria-label="Main navigation">
      {navItems.map(({ label, href }) => (
        <a
          href={href}
          class:list={['nav-tablet-link', { active: isActive(href) }]}
        >
          {label}
        </a>
      ))}
    </nav>
  </div>

  <!-- Desktop: numbered editorial grid -->
  <nav class="nav-desktop" aria-label="Main navigation">
    <ul class="nav-grid">
      {navItems.map(({ num, label, href }) => (
        <li>
          <a
            href={href}
            class:list={['nav-cell', { active: isActive(href) }]}
          >
            <span class="nav-num">{num}</span>
            <span class="nav-label">{label}</span>
            <span class="nav-dot" aria-hidden="true"></span>
          </a>
        </li>
      ))}
    </ul>
  </nav>

  <!-- Mobile: full-screen overlay -->
  <nav class="nav-overlay" aria-label="Main navigation">
    <ul class="overlay-list">
      {navItems.map(({ num, label, href }) => (
        <li>
          <a
            href={href}
            class:list={['overlay-link', { active: isActive(href) }]}
          >
            <span class="overlay-num">{num}</span>
            <span class="overlay-label">{label}</span>
          </a>
        </li>
      ))}
    </ul>
  </nav>
</header>

<script>
  const toggle = document.querySelector('.menu-toggle');
  const overlay = document.querySelector('.nav-overlay');

  toggle?.addEventListener('click', () => {
    const expanded = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!expanded));
    overlay?.classList.toggle('open');
    document.body.style.overflow = expanded ? '' : 'hidden';
  });

  overlay?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      toggle?.setAttribute('aria-expanded', 'false');
      overlay?.classList.remove('open');
      document.body.style.overflow = '';
    });
  });
</script>

<style>
  /* ===== Header bar (logo + hamburger / tablet links) ===== */

  .header-bar {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 200;
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: var(--nav-height);
    padding: 0 var(--space-4);
    background: var(--c-glass);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }

  @media (min-width: 640px) {
    .header-bar {
      padding: 0 var(--space-5);
    }
  }

  .logo {
    font-family: var(--font-display);
    font-size: clamp(1.1rem, 2.5vw, 1.4rem);
    text-transform: uppercase;
    letter-spacing: var(--tracking-display);
    line-height: 1;
    color: var(--c-daylight);
    white-space: nowrap;
  }

  /* ===== Hamburger toggle ===== */

  .menu-toggle {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: var(--space-2);
    width: var(--tap-min);
    height: var(--tap-min);
    padding: var(--space-3);
    z-index: 210;
  }

  .bar {
    display: block;
    width: 100%;
    height: 2px;
    background: var(--c-daylight);
    transition: transform var(--duration-md) var(--ease-out),
                opacity var(--duration-md) var(--ease-out);
    transform-origin: center;
  }

  /* Animate to X when open */
  .menu-toggle[aria-expanded='true'] .bar:nth-child(1) {
    transform: translateY(8px) rotate(45deg);
  }
  .menu-toggle[aria-expanded='true'] .bar:nth-child(2) {
    opacity: 0;
  }
  .menu-toggle[aria-expanded='true'] .bar:nth-child(3) {
    transform: translateY(-8px) rotate(-45deg);
  }

  /* Hide hamburger on tablet+ (tablet shows inline links, desktop shows grid) */
  @media (min-width: 640px) {
    .menu-toggle {
      display: none;
    }
  }

  /* ===== Tablet nav: plain horizontal links ===== */

  .nav-tablet {
    display: none;
  }

  @media (min-width: 640px) and (max-width: 1023px) {
    .nav-tablet {
      display: flex;
      gap: var(--space-5);
      align-items: center;
    }
  }

  .nav-tablet-link {
    font-family: var(--font-utility);
    font-weight: var(--weight-medium);
    font-size: var(--text-utility);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    color: var(--c-slate);
    padding: var(--space-3) var(--space-2);
    min-height: var(--tap-min);
    display: flex;
    align-items: center;
    transition: color var(--duration-sm) var(--ease-out);
  }

  .nav-tablet-link:hover {
    color: var(--c-daylight);
  }

  .nav-tablet-link.active {
    color: var(--c-tungsten);
  }

  /* ===== Desktop nav: numbered editorial grid ===== */

  .nav-desktop {
    display: none;
  }

  @media (min-width: 1024px) {
    .header-bar {
      border-bottom: none;
    }

    .nav-desktop {
      display: block;
      position: fixed;
      top: var(--nav-height);
      left: 0;
      right: 0;
      z-index: 190;
      background: var(--c-glass);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      border-top: 1px solid var(--c-negative);
      border-bottom: 1px solid var(--c-negative);
    }
  }

  .nav-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    list-style: none;
    max-width: var(--max-width);
    margin: 0 auto;
  }

  .nav-cell {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-4) var(--space-5);
    border-left: 1px solid var(--c-negative);
    transition: background var(--duration-sm) var(--ease-out);
  }

  .nav-cell:hover {
    background: var(--c-negative);
  }

  .nav-grid li:first-child .nav-cell {
    border-left: none;
  }

  .nav-num {
    font-family: var(--font-utility);
    font-weight: var(--weight-medium);
    font-size: var(--text-utility);
    letter-spacing: var(--tracking-wide);
    color: var(--c-slate);
    transition: color var(--duration-sm) var(--ease-out);
  }

  .nav-label {
    font-family: var(--font-utility);
    font-weight: var(--weight-semibold);
    font-size: var(--text-small);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    color: var(--c-slate);
    transition: color var(--duration-sm) var(--ease-out);
  }

  .nav-dot {
    width: 8px;
    height: 8px;
    background: var(--c-slate);
    margin-top: var(--space-1);
    transition: background var(--duration-sm) var(--ease-out);
  }

  .nav-cell:hover .nav-num,
  .nav-cell:hover .nav-label {
    color: var(--c-daylight);
  }

  .nav-cell:hover .nav-dot {
    background: var(--c-daylight);
  }

  .nav-cell.active .nav-num,
  .nav-cell.active .nav-label {
    color: var(--c-tungsten);
  }

  .nav-cell.active .nav-dot {
    background: var(--c-tungsten);
  }

  /* ===== Mobile overlay: full-screen chapter select ===== */

  .nav-overlay {
    position: fixed;
    inset: 0;
    z-index: 200;
    background: var(--c-darkroom);
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    visibility: hidden;
    transition: opacity var(--duration-md) var(--ease-out),
                visibility var(--duration-md) var(--ease-out);
  }

  .nav-overlay.open {
    opacity: 1;
    visibility: visible;
  }

  /* Only used on mobile */
  @media (min-width: 640px) {
    .nav-overlay {
      display: none !important;
    }
  }

  .overlay-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-7);
  }

  .overlay-link {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2);
    min-height: var(--tap-min);
    justify-content: center;
    padding: var(--space-2) var(--space-6);
  }

  .overlay-num {
    font-family: var(--font-utility);
    font-weight: var(--weight-medium);
    font-size: var(--text-utility);
    letter-spacing: var(--tracking-wide);
    color: var(--c-slate);
  }

  .overlay-label {
    font-family: var(--font-display);
    font-size: clamp(1.4rem, 5vw, 2rem);
    text-transform: uppercase;
    letter-spacing: var(--tracking-display);
    line-height: 1;
    color: var(--c-daylight);
  }

  .overlay-link.active .overlay-num {
    color: var(--c-tungsten);
  }

  .overlay-link.active .overlay-label {
    color: var(--c-tungsten);
  }
</style>
