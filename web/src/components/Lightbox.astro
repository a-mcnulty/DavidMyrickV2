---
import { extractVimeoId } from '../lib/sanity';
import type { Project } from '../lib/sanity';

interface Props {
  project: Project;
}

const { project } = Astro.props;
const fullVimeoId = project.fullVideoUrl ? extractVimeoId(project.fullVideoUrl) : null;
const dims = project.fullVideoDimensions;
---

{fullVimeoId && (
  <div
    class="lightbox"
    id={`lightbox-${project._id}`}
    data-lightbox-id={project._id}
    role="dialog"
    aria-modal="true"
    aria-label={project.title}
  >
    <div class="lightbox-backdrop" data-lightbox-close></div>

    <header class="lightbox-header">
      <div class="lightbox-meta">
        <span class="lightbox-title">{project.title}</span>
        {project.director && (
          <span class="lightbox-director">{project.director}</span>
        )}
      </div>
      <button
        class="lightbox-close"
        data-lightbox-close
        aria-label="Close"
      >
        <svg width="24" height="24" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
          <line x1="5" y1="5" x2="19" y2="19" />
          <line x1="19" y1="5" x2="5" y2="19" />
        </svg>
      </button>
    </header>

    <div class="lightbox-content">
      <div class="lightbox-player">
        <div
          class="player-wrapper"
          data-full-vimeo-id={fullVimeoId}
          style={dims ? `aspect-ratio: ${dims.width} / ${dims.height}` : undefined}
        >
          {/* Iframe injected on open by LightboxScript */}
          <div class="vp-overlay"></div>
          <div class="vp-controls">
            <button class="vp-play" type="button" aria-label="Play">
              <svg class="vp-icon-play" width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><polygon points="6,4 20,12 6,20" /></svg>
              <svg class="vp-icon-pause" width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><rect x="6" y="4" width="4" height="16" rx="1" /><rect x="14" y="4" width="4" height="16" rx="1" /></svg>
            </button>
            <div class="vp-timeline">
              <div class="vp-track"><div class="vp-progress"></div></div>
            </div>
            <button class="vp-mute" type="button" aria-label="Mute">
              <svg class="vp-icon-vol" width="18" height="18" viewBox="0 0 24 24"><path d="M11 5L6 9H2v6h4l5 4V5z" fill="currentColor" /><path d="M15.54 8.46a5 5 0 010 7.07" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" /><path d="M19.07 4.93a10 10 0 010 14.14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" /></svg>
              <svg class="vp-icon-muted" width="18" height="18" viewBox="0 0 24 24"><path d="M11 5L6 9H2v6h4l5 4V5z" fill="currentColor" /><line x1="23" y1="9" x2="17" y2="15" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" /><line x1="17" y1="9" x2="23" y2="15" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" /></svg>
            </button>
            <input type="range" class="vp-vol" min="0" max="1" step="0.01" value="1" aria-label="Volume" />
            <button class="vp-fs" type="button" aria-label="Full screen">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M8 3H5a2 2 0 00-2 2v3m18 0V5a2 2 0 00-2-2h-3m0 18h3a2 2 0 002-2v-3M3 16v3a2 2 0 002 2h3" /></svg>
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>
)}

<style>
  .lightbox {
    position: fixed;
    inset: 0;
    z-index: 500;
    display: flex;
    flex-direction: column;
    opacity: 0;
    visibility: hidden;
    transition: opacity var(--duration-md) var(--ease-out),
                visibility var(--duration-md) var(--ease-out);
  }

  .lightbox.open {
    opacity: 1;
    visibility: visible;
  }

  .lightbox-backdrop {
    position: absolute;
    inset: 0;
    background: var(--c-backdrop);
    cursor: pointer;
  }

  .lightbox-header {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-4) var(--space-5);
    min-height: var(--nav-height);
    flex-shrink: 0;
  }

  .lightbox-meta {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
    min-width: 0;
  }

  .lightbox-title {
    font-family: var(--font-display);
    font-size: clamp(0.9rem, 2vw, 1.2rem);
    text-transform: uppercase;
    letter-spacing: var(--tracking-display);
    color: var(--c-daylight);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .lightbox-director {
    font-family: var(--font-body);
    font-size: var(--text-small);
    color: var(--c-slate);
    letter-spacing: var(--tracking-normal);
    white-space: nowrap;
  }

  .lightbox-close {
    display: flex;
    align-items: center;
    justify-content: center;
    width: var(--tap-min);
    height: var(--tap-min);
    color: var(--c-daylight);
    flex-shrink: 0;
    transition: color var(--duration-sm) var(--ease-out);
  }

  .lightbox-close:hover {
    color: var(--c-tungsten);
  }

  .lightbox-content {
    position: relative;
    z-index: 1;
    flex: 1;
    display: flex;
    align-items: center;
    padding: 0;
    min-height: 0;
    overflow: hidden;
  }

  .lightbox-player {
    width: 100%;
    max-height: 100%;
  }

  .player-wrapper {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    max-height: calc(100vh - var(--nav-height));
    background: var(--c-darkroom);
    overflow: hidden;
  }

  .player-wrapper :global(.lightbox-video),
  .player-wrapper :global(.lightbox-video iframe) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  /* --- Custom video controls --- */

  .vp-play .vp-icon-pause { display: none; }
  .vp-play.is-paused .vp-icon-play { display: none; }
  .vp-play.is-paused .vp-icon-pause { display: block; }

  .vp-mute .vp-icon-muted { display: none; }
  .vp-mute.is-muted .vp-icon-vol { display: none; }
  .vp-mute.is-muted .vp-icon-muted { display: block; }

  .vp-overlay {
    position: absolute;
    inset: 0;
    z-index: 5;
    cursor: pointer;
  }

  .vp-controls {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 10;
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 16px;
    background: linear-gradient(transparent, rgba(0, 0, 0, 0.6));
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .vp-controls.visible {
    opacity: 1;
  }

  .vp-controls button {
    display: flex;
    align-items: center;
    justify-content: center;
    color: #fff;
    width: 36px;
    height: 36px;
    flex-shrink: 0;
    opacity: 0.9;
    transition: opacity 0.2s ease;
  }

  .vp-controls button:hover {
    opacity: 1;
  }

  .vp-timeline {
    flex: 1;
    display: flex;
    align-items: center;
    height: 28px;
    cursor: pointer;
  }

  .vp-track {
    width: 100%;
    height: 3px;
    background: rgba(255, 255, 255, 0.3);
    border-radius: 2px;
    position: relative;
    overflow: hidden;
    transition: height 0.15s ease;
  }

  .vp-timeline:hover .vp-track {
    height: 5px;
  }

  .vp-progress {
    height: 100%;
    background: var(--c-tally);
    width: 0%;
    border-radius: 2px;
    pointer-events: none;
  }

  .vp-vol {
    -webkit-appearance: none;
    appearance: none;
    width: 64px;
    height: 3px;
    background: rgba(255, 255, 255, 0.3);
    border-radius: 2px;
    outline: none;
    cursor: pointer;
    flex-shrink: 0;
  }

  .vp-vol::-webkit-slider-thumb {
    -webkit-appearance: none;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: #fff;
    cursor: pointer;
  }

  .vp-vol::-moz-range-thumb {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: #fff;
    border: none;
    cursor: pointer;
  }

  @media (max-width: 639px) {
    .vp-mute,
    .vp-vol {
      display: none;
    }
  }
</style>
