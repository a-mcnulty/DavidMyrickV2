---
import { extractVimeoId } from '../lib/sanity';
import type { Project } from '../lib/sanity';

interface Props {
  project: Project;
}

const { project } = Astro.props;
const fullVimeoId = project.fullVideoUrl ? extractVimeoId(project.fullVideoUrl) : null;
const dims = project.fullVideoDimensions;
---

{fullVimeoId && (
  <div
    class="lightbox"
    id={`lightbox-${project._id}`}
    data-lightbox-id={project._id}
    role="dialog"
    aria-modal="true"
    aria-label={project.title}
  >
    <div class="lightbox-backdrop" data-lightbox-close></div>

    <header class="lightbox-header">
      <div class="lightbox-meta">
        <span class="lightbox-title">{project.title}</span>
        {project.director && (
          <span class="lightbox-director">{project.director}</span>
        )}
      </div>
      <button
        class="lightbox-close"
        data-lightbox-close
        aria-label="Close"
      >
        <svg width="24" height="24" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
          <line x1="5" y1="5" x2="19" y2="19" />
          <line x1="19" y1="5" x2="5" y2="19" />
        </svg>
      </button>
    </header>

    <div class="lightbox-content">
      <div class="lightbox-player">
        <div
          class="player-wrapper"
          data-full-vimeo-id={fullVimeoId}
          style={dims ? `aspect-ratio: ${dims.width} / ${dims.height}` : undefined}
        >
          {/* Player injected on open by LightboxScript (Plyr + Vimeo) */}
        </div>
      </div>
    </div>
  </div>
)}

<style>
  .lightbox {
    position: fixed;
    inset: 0;
    z-index: 500;
    display: flex;
    flex-direction: column;
    padding-bottom: env(safe-area-inset-bottom, 0px);
    opacity: 0;
    visibility: hidden;
    transition: opacity var(--duration-md) var(--ease-out),
                visibility var(--duration-md) var(--ease-out);
  }

  .lightbox.open {
    opacity: 1;
    visibility: visible;
  }

  .lightbox-backdrop {
    position: absolute;
    inset: 0;
    background: var(--c-backdrop);
    cursor: pointer;
  }

  .lightbox-header {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    z-index: 10;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-4) var(--space-5);
    padding-top: max(var(--space-4), env(safe-area-inset-top, 0px));
    background: linear-gradient(rgba(0, 0, 0, 0.6), transparent);
    pointer-events: none;
  }

  .lightbox-header > * {
    pointer-events: auto;
  }

  .lightbox-meta {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
    min-width: 0;
  }

  .lightbox-title {
    font-family: var(--font-display);
    font-size: clamp(0.9rem, 2vw, 1.2rem);
    text-transform: uppercase;
    letter-spacing: var(--tracking-display);
    color: var(--c-daylight);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .lightbox-director {
    font-family: var(--font-body);
    font-size: var(--text-small);
    color: var(--c-slate);
    letter-spacing: var(--tracking-normal);
    white-space: nowrap;
  }

  .lightbox-close {
    display: flex;
    align-items: center;
    justify-content: center;
    width: var(--tap-min);
    height: var(--tap-min);
    color: var(--c-daylight);
    flex-shrink: 0;
    transition: color var(--duration-sm) var(--ease-out);
  }

  .lightbox-close:hover {
    color: var(--c-tungsten);
  }

  .lightbox-content {
    position: relative;
    z-index: 1;
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    min-height: 0;
    overflow: hidden;
  }

  .lightbox-player {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .player-wrapper {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    max-height: 100%;
    background: var(--c-darkroom);
    overflow: hidden;
  }

  .player-wrapper :global(.plyr) {
    position: absolute;
    inset: 0;
    height: 100%;
    overflow: hidden;
  }

  .player-wrapper :global(.plyr__video-embed) {
    height: 100%;
    padding-bottom: 0 !important;
  }

  .player-wrapper :global(.plyr__video-embed iframe) {
    width: 100%;
    height: 100%;
    border: 0;
  }

  .player-wrapper {
    --plyr-color-main: var(--c-tally);
  }
</style>
