---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import VimeoEmbed from '../../components/VimeoEmbed.astro';
import { getAllProjects, getProjectBySlug, urlFor } from '../../lib/sanity';
import type { GetStaticPaths } from 'astro';

export const getStaticPaths: GetStaticPaths = async () => {
  const projects = await getAllProjects();
  return projects.map((p) => ({
    params: { slug: p.slug.current },
  }));
};

const { slug } = Astro.params;
const project = await getProjectBySlug(slug!);

if (!project) {
  return Astro.redirect('/404');
}

const categoryLabels: Record<string, string> = {
  photography: 'Photography',
  'music-video': 'Music Video',
  commercial: 'Commercial',
  narrative: 'Narrative',
};
---

<BaseLayout title={`${project.title} — David J Myrick`}>
  <Header />
  <main class="page">
    <div class="container">
      <a href={`/${project.category}`} class="back-link">
        &larr; {categoryLabels[project.category] || project.category}
      </a>

      <h1 class="project-title">{project.title}</h1>

      {project.vimeoUrl && (
        <section class="video-section">
          <VimeoEmbed url={project.vimeoUrl} title={project.title} />
        </section>
      )}

      {project.gallery && project.gallery.length > 0 && (
        <section class="gallery">
          {project.gallery.map((image) => {
            const imgUrl = urlFor(image).width(1200).format('webp').url();
            const caption = (image as any).caption;
            return (
              <figure class="gallery-item">
                <img
                  src={imgUrl}
                  alt={caption || project.title}
                  loading="lazy"
                  width="1200"
                />
                {caption && <figcaption>{caption}</figcaption>}
              </figure>
            );
          })}
        </section>
      )}
    </div>
  </main>
  <Footer />
</BaseLayout>

<style>
  .page {
    padding-top: calc(var(--nav-height) + 48px);
  }

  .back-link {
    display: inline-block;
    font-size: 0.85rem;
    color: var(--color-text-muted);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    margin-bottom: 24px;
    transition: color 0.2s ease;
  }

  .back-link:hover {
    color: var(--color-text);
  }

  .project-title {
    font-size: clamp(1.8rem, 4vw, 3rem);
    font-weight: 300;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    margin-bottom: 40px;
  }

  .video-section {
    margin-bottom: 48px;
  }

  .gallery {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .gallery-item {
    border-radius: 4px;
    overflow: hidden;
  }

  .gallery-item img {
    width: 100%;
    height: auto;
  }

  figcaption {
    padding: 12px 0 4px;
    font-size: 0.8rem;
    color: var(--color-text-muted);
    letter-spacing: 0.02em;
  }
</style>
