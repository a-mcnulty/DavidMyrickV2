---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Lightbox from '../components/Lightbox.astro';
import LightboxScript from '../components/LightboxScript.astro';
import { getProjectsByCategory } from '../lib/sanity';

const projects = await getProjectsByCategory('narrative');
---

<BaseLayout title="Narrative — David J Myrick">
  <Header />
  <main>
    {projects.length > 0 ? (
      <section class="tile-stack">
        {projects.map((project, i) => (
          <ProjectCard
            id={project._id}
            title={project.title}
            coverImage={project.coverImage}
            subcategory={project.subcategory}
            director={project.director}
            tileVideoUrl={project.tileVideoUrl}
            tileVideoDimensions={project.tileVideoDimensions}
            index={i}
          />
        ))}
      </section>
    ) : (
      <p class="empty">No projects yet.</p>
    )}

    {projects.map((project) => (
      <Lightbox project={project} />
    ))}
  </main>
  <Footer />
  <LightboxScript />
</BaseLayout>

<style>
  .tile-stack {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding-top: var(--header-total);
  }

  .empty {
    text-align: center;
    color: var(--c-slate);
    padding: var(--space-9) 0;
    font-family: var(--font-body);
    font-size: var(--text-body);
  }
</style>
