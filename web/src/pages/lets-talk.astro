---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout title="Let's Talk — David J Myrick">
  <Header />
  <main class="page">
    <div class="content">
      <h1 class="page-heading">Let's Talk</h1>

      <section class="profile">
        <h2 class="profile-name">David J. Myrick</h2>
        <p class="profile-detail">Located In California.</p>
        <p class="profile-detail">IATSE Local 600 Member</p>

        <div class="social-links">
          <a href="https://www.instagram.com/davidmyrick" target="_blank" rel="noopener noreferrer">Instagram</a>
          <a href="https://www.imdb.com/name/nm1651647/" target="_blank" rel="noopener noreferrer">IMDb</a>
          <a href="/MYRICK_DAVID.pdf" target="_blank" rel="noopener noreferrer">Resume</a>
        </div>
      </section>

      <section class="agency">
        <div class="agency-header">
          <h3 class="agency-label">Agency</h3>
          <p class="agency-name">Paradigm Talent Agency</p>
          <p class="agency-address">700 N San Vicente Blvd Ste G820, 8th Floor</p>
          <p class="agency-address">West Hollywood, CA 90069</p>
          <p class="agency-phone">t: 310-288-8000</p>
        </div>

        <div class="contacts">
          <div class="contact-block">
            <h4 class="contact-type">Feature</h4>
            <p class="contact-name">Johnathan Silverman</p>
            <a href="mailto:jsilverman@paradigmagency.com" class="contact-email">jsilverman@paradigmagency.com</a>
          </div>

          <div class="contact-block">
            <h4 class="contact-type">Commercial</h4>
            <p class="contact-name">Michael Kirschner</p>
            <a href="mailto:mkirschner@paradigmagency.com" class="contact-email">mkirschner@paradigmagency.com</a>
          </div>
        </div>
      </section>

      <section class="bio">
        <p>"Raised in California, grew up in a camera shop that was owned and operated by a father who had a passion for fine art photography. Visited the darkrooms of some of the greatest B&W photographers of this decade, including Ansel Adams & Edward Weston. Set out to make a career in film making with only a wild idea of this becoming a reality. Always approaching every job as an opportunity and an emotion on how to become better at what I set out to do."</p>
      </section>
    </div>
  </main>
  <Footer />
</BaseLayout>

<style>
  .page {
    padding-top: calc(var(--header-total) + var(--space-8));
    padding-bottom: var(--space-10);
    min-height: 100vh;
  }

  .content {
    max-width: 720px;
    margin: 0 auto;
    padding: 0 var(--space-4);
  }

  @media (min-width: 640px) {
    .content {
      padding: 0 var(--space-5);
    }
  }

  .page-heading {
    font-family: var(--font-display);
    font-size: var(--text-hero);
    text-transform: uppercase;
    letter-spacing: var(--tracking-display);
    line-height: 1.05;
    color: var(--c-daylight);
    margin-bottom: var(--space-9);
  }

  /* --- Profile --- */

  .profile {
    margin-bottom: var(--space-8);
  }

  .profile-name {
    font-family: var(--font-display);
    font-size: var(--text-heading);
    text-transform: uppercase;
    letter-spacing: var(--tracking-display);
    line-height: 1.1;
    color: var(--c-daylight);
    margin-bottom: var(--space-3);
  }

  .profile-detail {
    font-family: var(--font-body);
    font-size: var(--text-body);
    color: var(--c-slate);
    line-height: 1.6;
  }

  .social-links {
    display: flex;
    gap: var(--space-5);
    margin-top: var(--space-4);
  }

  .social-links a {
    font-family: var(--font-utility);
    font-size: var(--text-utility);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    color: var(--c-slate);
    transition: color var(--duration-sm) var(--ease-out);
  }

  .social-links a:hover {
    color: var(--c-daylight);
  }

  /* --- Bio --- */

  .bio {
    border-top: 1px solid var(--c-daylight);
    margin-top: var(--space-9);
    padding-top: var(--space-7);
  }

  .bio p {
    font-family: var(--font-body);
    font-size: var(--text-body);
    color: var(--c-daylight);
    line-height: 1.8;
    font-style: italic;
  }

  /* --- Agency --- */

  .agency {
    border-top: 1px solid var(--c-daylight);
    padding-top: var(--space-7);
  }

  .agency-label {
    font-family: var(--font-utility);
    font-size: var(--text-utility);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    color: var(--c-slate);
    margin-bottom: var(--space-3);
  }

  .agency-name {
    font-family: var(--font-display);
    font-size: var(--text-subhead);
    text-transform: uppercase;
    letter-spacing: var(--tracking-display);
    color: var(--c-daylight);
    margin-bottom: var(--space-2);
  }

  .agency-address,
  .agency-phone {
    font-family: var(--font-body);
    font-size: var(--text-small);
    color: var(--c-slate);
    line-height: 1.6;
  }

  .agency-phone {
    margin-top: var(--space-2);
  }

  .contacts {
    display: flex;
    flex-direction: column;
    gap: var(--space-7);
    margin-top: var(--space-7);
  }

  @media (min-width: 640px) {
    .contacts {
      flex-direction: row;
      gap: var(--space-9);
    }
  }

  .contact-block {
    flex: 1;
  }

  .contact-type {
    font-family: var(--font-utility);
    font-size: var(--text-utility);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    color: var(--c-slate);
    margin-bottom: var(--space-2);
  }

  .contact-name {
    font-family: var(--font-body);
    font-size: var(--text-body);
    color: var(--c-daylight);
    margin-bottom: var(--space-1);
  }

  .contact-email {
    font-family: var(--font-body);
    font-size: var(--text-small);
    color: var(--c-tungsten);
    transition: color var(--duration-sm) var(--ease-out);
  }

  .contact-email:hover {
    color: var(--c-daylight);
  }
</style>

<script>
  function initLetsTalkTracking() {
    document.querySelectorAll<HTMLAnchorElement>('.contact-email').forEach((link) => {
      link.addEventListener('click', () => {
        if (typeof gtag === 'function') {
          const contactType = link.closest('.contact-block')?.querySelector('.contact-type')?.textContent || 'unknown';
          gtag('event', 'mailto_click', {
            contact_type: contactType,
          });
        }
      });
    });

    document.querySelectorAll<HTMLAnchorElement>('.social-links a').forEach((link) => {
      link.addEventListener('click', () => {
        if (typeof gtag === 'function') {
          const label = link.textContent?.trim() || 'unknown';
          if (label === 'Resume') {
            gtag('event', 'resume_download');
          }
        }
      });
    });
  }
  document.addEventListener('astro:page-load', initLetsTalkTracking);
</script>
