---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Lightbox from '../components/Lightbox.astro';
import LightboxScript from '../components/LightboxScript.astro';
import { getAllProjects } from '../lib/sanity';

const projects = await getAllProjects();

---

<BaseLayout>
  <Header />

  <main>
    {/* ===== Project tiles ===== */}
    <section class="tile-stack">
      {projects.map((project, i) => (
        <div class="tile-item">
          <ProjectCard
            id={project._id}
            title={project.title}
            coverImage={project.coverImage}
            subcategory={project.subcategory}
            director={project.director}
            tileVideoUrl={project.tileVideoUrl}
            tileVideoDimensions={project.tileVideoDimensions}
            index={i}
          />
        </div>
      ))}
    </section>

    {/* ===== Lightboxes (one per project, hidden) ===== */}
    {projects.map((project) => (
      <Lightbox project={project} />
    ))}
  </main>

  <Footer />
  <LightboxScript />
</BaseLayout>

<style>
  /* ===== Tile stack ===== */

  .tile-stack {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding-top: var(--header-total);
  }

</style>
