---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import TileTransitions from '../components/TileTransitions.astro';

interface Props {
  title?: string;
}

const { title = 'David J Myrick — Director of Photography' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="David J Myrick — Director of Photography. Photography, music videos, commercials, and narrative work." />

    <link rel="preconnect" href="https://cdn.sanity.io" crossorigin />
    <link rel="preconnect" href="https://player.vimeo.com" />
    <link rel="preconnect" href="https://i.vimeocdn.com" />

    <link rel="icon" href="/favicon.ico" sizes="any">
    <link rel="icon" href="/favicon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">

    <link rel="preload" href="/fonts/bebas-neue-400.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/barlow-400.woff2" as="font" type="font/woff2" crossorigin />

    <script is:inline>
      (function() {
        var t = localStorage.getItem('theme') || 'light';
        document.documentElement.setAttribute('data-theme', t);
        document.addEventListener('astro:after-swap', function() {
          document.documentElement.setAttribute('data-theme', localStorage.getItem('theme') || 'light');
        });
      })();
    </script>
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-8VY31F22SJ"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-8VY31F22SJ');

      document.addEventListener('astro:page-load', function() {
        if (typeof gtag === 'function') {
          gtag('event', 'page_view', {
            page_location: window.location.href,
            page_title: document.title
          });
        }
      });
    </script>
    <ClientRouter />
    <title>{title}</title>
  </head>
  <body>
    <slot />
    <TileTransitions />
  </body>
</html>
